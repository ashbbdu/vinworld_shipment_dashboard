[Unit]
Description=VIN World Shipment Pipeline (UAT)
After=network.target

[Service]
Type=simple
Environment=PIPELINE_ENV=uat
ExecStart=/usr/bin/python3 -m pipeline.service
WorkingDirectory=/home/ubuntu/vin_world_shipment_dashboard
Restart=always
RestartSec=10
User=ubuntu

[Install]
WantedBy=multi-user.target